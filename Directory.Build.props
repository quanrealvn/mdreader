<!-- Directory.Build.props -->
<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- NuGet vulnerability audit stays visible but must not break builds when a new advisory is published. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Deterministic>true</Deterministic>
    <!-- Product metadata (WP11). installer\build.ps1 reads Version (and passes -p:Version=<x> to publish); the installer takes
         publisher and copyright from MdReader.exe. AssemblyVersion/FileVersion derive from Version (1.0.0 -> 1.0.0.0). -->
    <Version>1.2.0</Version>
    <Company>quanrealvn</Company>
    <Product>MdReader</Product>
    <Copyright>Copyright (c) 2026 quanrealvn</Copyright>
  </PropertyGroup>
</Project>
