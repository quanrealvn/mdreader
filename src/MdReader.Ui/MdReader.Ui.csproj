<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Phase 2 of docs/AVALONIA-PLAN.md. The Windows build is unchanged and still sits on the WebView2 backend; the
         plain net10.0 build is the macOS one, on the WKWebView backend. Everything that differs is either behind a
         seam or under Platform\Windows and Platform\Mac, which are swapped below. -->
    <TargetFrameworks>net10.0-windows;net10.0</TargetFrameworks>
    <AssemblyName>MdReader.Ui</AssemblyName>
    <RootNamespace>MdReader.Ui</RootNamespace>
    <!-- Interop/NativeMethods.cs, WebView/NativeMethods.cs and Platform\Mac use [LibraryImport]. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- AVLN3001: the main window has no parameterless constructor because it is only ever built by the composition
         root, exactly as in the WPF shell. Nothing loads its XAML through the runtime loader. -->
    <NoWarn>$(NoWarn);AVLN3001</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\MdReader.ico</ApplicationIcon>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MdReader.Core\MdReader.Core.csproj" />
    <ProjectReference Include="..\MdReader.Shell\MdReader.Shell.csproj" />
  </ItemGroup>

  <!-- Windows: the WebView2 backend, the Win32 dialogs and the native host window. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <PackageReference Include="Microsoft.Web.WebView2" />
    <ProjectReference Include="..\MdReader.Edge\MdReader.Edge.csproj" />
    <Compile Remove="Platform\Mac\**\*.cs" />
  </ItemGroup>

  <!-- macOS: the WKWebView backend. Nothing Windows-only compiles. -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0-windows'">
    <ProjectReference Include="..\MdReader.Mac\MdReader.Mac.csproj" />
    <Compile Remove="Platform\Windows\**\*.cs" />
    <Compile Remove="Interop\**\*.cs" />
    <Compile Remove="WebView\**\*.cs" />
    <Compile Remove="Documents\WebView2HostSurface.cs" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MdReader.Ui.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Same as MdReader.App: the web assets live at the repo root and are copied to <output>\web. -->
    <Content Include="..\..\web\**\*" LinkBase="web" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The WebView2 package references its WPF and WinForms wrappers unconditionally. This project uses neither, and
       keeping them pulls in WindowsBase 5.0.0.0, which conflicts with the net10.0 facade (MSB3277). -->
  <Target Name="RemoveWebView2DesktopUiAssemblies" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <_WebView2DesktopUiReference Include="@(Reference)"
                                   Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf' Or '%(Filename)' == 'Microsoft.Web.WebView2.WinForms'" />
      <Reference Remove="@(_WebView2DesktopUiReference)" />
    </ItemGroup>
  </Target>

</Project>
