<!-- Find bar (ARCHITECTURE §4.12): native WebView2 Find API driven from WPF. Docked above the WebView because WPF
     content can't be drawn over the WebView2 HwndHost (airspace). Brush keys come from Themes/Light.xaml / Dark.xaml (§10). -->
<UserControl x:Class="MdReader.App.Views.FindBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.AutomationId="FindBar"
             AutomationProperties.Name="Find in document"
             Visibility="Collapsed"
             Focusable="False">
    <UserControl.Resources>
        <Style x:Key="FindBarIconButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.Button.Hover.Background}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Brush.Button.Pressed.Background}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource Brush.FindBar.Background}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="0,0,0,1"
            Padding="12,6">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Border Width="280"
                    Height="28"
                    CornerRadius="4"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource Brush.Border}"
                    Background="{DynamicResource Brush.Document.Background}">
                <Grid>
                    <TextBox x:Name="FindTextBox"
                             AutomationProperties.AutomationId="FindTextBox"
                             AutomationProperties.Name="Find in document"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{DynamicResource Brush.Foreground}"
                             CaretBrush="{DynamicResource Brush.Foreground}"
                             SelectionBrush="{DynamicResource Brush.Accent}"
                             VerticalContentAlignment="Center"
                             Padding="4,0,64,0"
                             MaxLength="1000"
                             TextChanged="OnFindTextChanged" />
                    <TextBlock x:Name="FindMatchCount"
                               AutomationProperties.AutomationId="FindMatchCount"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"
                               Foreground="{DynamicResource Brush.Foreground.Muted}"
                               IsHitTestVisible="False" />
                </Grid>
            </Border>
            <Button x:Name="FindPreviousButton"
                    Style="{StaticResource FindBarIconButton}"
                    Margin="6,0,0,0"
                    AutomationProperties.AutomationId="FindPreviousButton"
                    AutomationProperties.Name="Previous match"
                    ToolTip="Previous match (Shift+F3)"
                    Content="&#xE70E;"
                    Click="OnPreviousClick" />
            <Button x:Name="FindNextButton"
                    Style="{StaticResource FindBarIconButton}"
                    AutomationProperties.AutomationId="FindNextButton"
                    AutomationProperties.Name="Next match"
                    ToolTip="Next match (F3)"
                    Content="&#xE70D;"
                    Click="OnNextClick" />
            <Button x:Name="FindCloseButton"
                    Style="{StaticResource FindBarIconButton}"
                    AutomationProperties.AutomationId="FindCloseButton"
                    AutomationProperties.Name="Close find"
                    ToolTip="Close (Esc)"
                    Content="&#xE711;"
                    Click="OnCloseClick" />
        </StackPanel>
    </Border>
</UserControl>
