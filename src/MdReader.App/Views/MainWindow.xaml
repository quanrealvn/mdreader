<!--
  Main window (§4.11). Row 0: compact 40 px chrome — tab strip on the left, toolbar on the right. Row 1: DocumentHost (one
  WebView2 per tab, WP6) with EmptyState on top when no tab is open. The status toast is a Popup (its own HWND) because WPF
  content can't be drawn over the WebView2 HWND (airspace).
  DataContext = MainViewModel. Keyboard shortcuts: Commands/KeyboardShortcuts (PreviewKeyDown router, no InputBindings).
-->
<Window x:Class="MdReader.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:MdReader.App.Views"
        xmlns:cmd="clr-namespace:MdReader.App.Commands"
        Title="{Binding WindowTitle}"
        AutomationProperties.AutomationId="MainWindow"
        MinWidth="560" MinHeight="360"
        Background="{DynamicResource Brush.Chrome.Background}"
        Foreground="{DynamicResource Brush.Foreground}"
        FontFamily="{StaticResource Font.Ui}"
        FontSize="{StaticResource FontSize.Body}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        AllowDrop="True"
        PreviewDragEnter="OnPreviewDragOver"
        PreviewDragOver="OnPreviewDragOver"
        PreviewDrop="OnPreviewDrop">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <ContextMenu x:Key="MoreMenu" AutomationProperties.Name="More options">
            <MenuItem Header="_Save" Command="{Binding SaveCommand}"
                      AutomationProperties.AutomationId="SaveMenuItem"
                      InputGestureText="{Binding Source={x:Static cmd:KeyboardShortcuts.MenuGestures}, Path=[SaveMenuItem]}">
                <MenuItem.Icon>
                    <TextBlock Style="{StaticResource MenuIconStyle}" Text="&#xE74E;" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="_Reload" Command="{Binding ReloadCommand}"
                      AutomationProperties.AutomationId="ReloadMenuItem"
                      InputGestureText="{Binding Source={x:Static cmd:KeyboardShortcuts.MenuGestures}, Path=[ReloadMenuItem]}">
                <MenuItem.Icon>
                    <TextBlock Style="{StaticResource MenuIconStyle}" Text="&#xE72C;" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="_Print…" Command="{Binding PrintCommand}"
                      AutomationProperties.AutomationId="PrintMenuItem"
                      InputGestureText="{Binding Source={x:Static cmd:KeyboardShortcuts.MenuGestures}, Path=[PrintMenuItem]}">
                <MenuItem.Icon>
                    <TextBlock Style="{StaticResource MenuIconStyle}" Text="&#xE749;" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="_Export as PDF…" Command="{Binding ExportPdfCommand}"
                      AutomationProperties.AutomationId="ExportPdfMenuItem"
                      InputGestureText="{Binding Source={x:Static cmd:KeyboardShortcuts.MenuGestures}, Path=[ExportPdfMenuItem]}">
                <MenuItem.Icon>
                    <TextBlock Style="{StaticResource MenuIconStyle}" Text="&#xEA90;" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <!-- §14 reading style: checked = Colorful (default), unchecked = Classic. The menu template has no check glyph,
                 so the icon column shows a check mark while checked. -->
            <MenuItem Header="_Colorful style" IsCheckable="True" IsChecked="{Binding IsColorfulStyle, Mode=TwoWay}"
                      AutomationProperties.AutomationId="ReadingStyleMenuItem">
                <MenuItem.Icon>
                    <TextBlock Style="{StaticResource MenuIconStyle}" Text="&#xE73E;"
                               Visibility="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=MenuItem}, Converter={StaticResource BoolToVisibility}}" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="_About MdReader" Click="OnAboutClick" AutomationProperties.AutomationId="AboutMenuItem">
                <MenuItem.Icon>
                    <TextBlock Style="{StaticResource MenuIconStyle}" Text="&#xE946;" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <!-- Items are rebuilt from MainViewModel.RecentFiles every time the menu opens (MainWindow.xaml.cs). -->
        <ContextMenu x:Key="RecentMenu" AutomationProperties.Name="Recent files" MaxWidth="560" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Chrome hairline; drawn first so the active tab (document background) covers it and merges with the document. -->
        <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom" Background="{DynamicResource Brush.Border}" />

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <views:TabStrip Grid.Column="0" Margin="6,0,8,0" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,1"
                        AutomationProperties.Name="Toolbar">
                <Button x:Name="OpenButton" Style="{StaticResource IconButtonStyle}" Content="&#xED25;"
                        Command="{Binding OpenCommand}"
                        AutomationProperties.AutomationId="OpenButton" AutomationProperties.Name="Open"
                        ToolTip="{Binding Source={x:Static cmd:KeyboardShortcuts.ToolTips}, Path=[OpenButton]}" />
                <Button x:Name="RecentButton" Style="{StaticResource IconButtonStyle}" Width="Auto" Padding="8,0,6,0"
                        Click="OnRecentButtonClick"
                        AutomationProperties.AutomationId="RecentButton" AutomationProperties.Name="Recent files"
                        ToolTip="{Binding Source={x:Static cmd:KeyboardShortcuts.ToolTips}, Path=[RecentButton]}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE81C;" VerticalAlignment="Center" />
                        <TextBlock Text="&#xE70D;" FontSize="8" Margin="5,2,0,0" VerticalAlignment="Center" Opacity="0.75" />
                    </StackPanel>
                </Button>

                <Border Style="{StaticResource ToolbarSeparatorStyle}" />

                <ToggleButton x:Name="TocToggleButton" Style="{StaticResource IconToggleButtonStyle}" Content="&#xE8FD;"
                              IsChecked="{Binding IsTocVisible, Mode=TwoWay}" IsEnabled="{Binding HasTabs}"
                              AutomationProperties.AutomationId="TocToggleButton" AutomationProperties.Name="Table of contents"
                              ToolTip="{Binding Source={x:Static cmd:KeyboardShortcuts.ToolTips}, Path=[TocToggleButton]}" />
                <Button x:Name="FindButton" Style="{StaticResource IconButtonStyle}" Content="&#xE721;"
                        Command="{Binding FindCommand}"
                        AutomationProperties.AutomationId="FindButton" AutomationProperties.Name="Find"
                        ToolTip="{Binding Source={x:Static cmd:KeyboardShortcuts.ToolTips}, Path=[FindButton]}" />
                <Button x:Name="ExportPdfButton" Style="{StaticResource IconButtonStyle}" Content="&#xEA90;"
                        Command="{Binding ExportPdfCommand}"
                        AutomationProperties.AutomationId="ExportPdfButton" AutomationProperties.Name="Export PDF"
                        ToolTip="{Binding Source={x:Static cmd:KeyboardShortcuts.ToolTips}, Path=[ExportPdfButton]}" />
                <ToggleButton x:Name="SplitViewButton" Style="{StaticResource IconToggleButtonStyle}" Content="&#xE745;"
                              IsChecked="{Binding IsSplitView, Mode=TwoWay}" IsEnabled="{Binding HasTabs}"
                              AutomationProperties.AutomationId="SplitViewButton" AutomationProperties.Name="Split view"
                              ToolTip="{Binding Source={x:Static cmd:KeyboardShortcuts.ToolTips}, Path=[SplitViewButton]}" />
                <Button x:Name="ThemeButton" Style="{StaticResource IconButtonStyle}" Content="{Binding ThemeGlyph}"
                        Command="{Binding CycleThemeCommand}"
                        AutomationProperties.AutomationId="ThemeButton" AutomationProperties.Name="Theme"
                        AutomationProperties.HelpText="{Binding ThemeDescription}"
                        ToolTip="{Binding ThemeToolTip}" />

                <Border Style="{StaticResource ToolbarSeparatorStyle}" />

                <Button x:Name="ZoomOutButton" Style="{StaticResource IconButtonStyle}" Content="&#xE738;" FontSize="13"
                        Command="{Binding ZoomOutCommand}"
                        AutomationProperties.AutomationId="ZoomOutButton" AutomationProperties.Name="Zoom out"
                        ToolTip="{Binding Source={x:Static cmd:KeyboardShortcuts.ToolTips}, Path=[ZoomOutButton]}" />
                <Button x:Name="ZoomResetButton" Style="{StaticResource TextButtonStyle}" Content="{Binding ZoomText}"
                        Command="{Binding ZoomResetCommand}"
                        AutomationProperties.AutomationId="ZoomResetButton" AutomationProperties.Name="{Binding ZoomText}"
                        ToolTip="{Binding Source={x:Static cmd:KeyboardShortcuts.ToolTips}, Path=[ZoomResetButton]}" />
                <Button x:Name="ZoomInButton" Style="{StaticResource IconButtonStyle}" Content="&#xE710;" FontSize="13"
                        Command="{Binding ZoomInCommand}"
                        AutomationProperties.AutomationId="ZoomInButton" AutomationProperties.Name="Zoom in"
                        ToolTip="{Binding Source={x:Static cmd:KeyboardShortcuts.ToolTips}, Path=[ZoomInButton]}" />

                <Border Style="{StaticResource ToolbarSeparatorStyle}" />

                <Button x:Name="MoreButton" Style="{StaticResource IconButtonStyle}" Content="&#xE712;"
                        Click="OnMoreButtonClick"
                        AutomationProperties.AutomationId="MoreButton" AutomationProperties.Name="More options"
                        ToolTip="{Binding Source={x:Static cmd:KeyboardShortcuts.ToolTips}, Path=[MoreButton]}" />
            </StackPanel>
        </Grid>

        <Grid x:Name="DocumentArea" Grid.Row="1" Background="{DynamicResource Brush.Document.Background}">
            <views:DocumentHost Tabs="{Binding Tabs}" AutomationProperties.AutomationId="DocumentHost" />
            <!-- EmptyState is created on first need (no tabs) by MainWindow.xaml.cs, so a launch that opens documents
                 never builds it (startup cost). -->
            <ContentControl x:Name="EmptyStateHost" Focusable="False" IsTabStop="False" Visibility="Collapsed"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />

            <!-- Zero-size anchor at the bottom-left corner; the status toast opens just above it. -->
            <FrameworkElement x:Name="StatusAnchor" Width="0" Height="0" Margin="14,0,0,14"
                              HorizontalAlignment="Left" VerticalAlignment="Bottom" />
        </Grid>

        <Popup x:Name="StatusPopup" PlacementTarget="{Binding ElementName=StatusAnchor}" Placement="Top"
               AllowsTransparency="True" PopupAnimation="Fade" StaysOpen="True" Focusable="False">
            <Border Margin="4,6,8,10" CornerRadius="6" Background="{DynamicResource Brush.Toast.Background}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Padding="12,8,14,9" MaxWidth="560"
                    MouseLeftButtonUp="OnStatusClicked" Cursor="Hand">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.22" Color="Black" />
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource IconTextStyle}" FontSize="14" Text="&#xE946;" Margin="0,1,10,0"
                               VerticalAlignment="Top" Foreground="{DynamicResource Brush.Toast.Foreground}" Opacity="0.85" />
                    <TextBlock x:Name="StatusText" Text="{Binding StatusText}" TextWrapping="Wrap" MaxWidth="500"
                               Foreground="{DynamicResource Brush.Toast.Foreground}" FontSize="13"
                               AutomationProperties.AutomationId="StatusText"
                               AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
