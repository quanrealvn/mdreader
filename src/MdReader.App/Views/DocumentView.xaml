<!-- One document tab's view (ARCHITECTURE §4.10–§4.12): the tab's WebView2 (created in code into WebViewHost, never
     re-parented; replaced by a new control only to recover from a failed initialization or a dead browser process), the find
     bar docked above it (WPF can't draw over the WebView2 HwndHost), and a WPF error panel used only when the page itself
     can't be shown (protocol mismatch, repeated renderer crashes, WebView2 failure). -->
<UserControl x:Class="MdReader.App.Views.DocumentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:MdReader.App.Views"
             AutomationProperties.AutomationId="DocumentView"
             Focusable="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <views:FindBar x:Name="FindBarControl" Grid.Row="0" />

        <!-- Split view (§4.10): the Markdown source on the left, the preview on the right. Both left columns collapse to
             zero width in preview-only mode, so the WebView keeps the whole area and is never re-parented. -->
        <Grid x:Name="SplitGrid" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="EditorColumn" Width="0" />
                <ColumnDefinition x:Name="SplitterColumn" Width="0" />
                <ColumnDefinition x:Name="PreviewColumn" Width="*" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="EditorBox"
                     Grid.Column="0"
                     Visibility="Collapsed"
                     AutomationProperties.AutomationId="EditorTextBox"
                     AutomationProperties.Name="Markdown source"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     TextWrapping="NoWrap"
                     HorizontalScrollBarVisibility="Auto"
                     VerticalScrollBarVisibility="Auto"
                     FontFamily="Cascadia Mono, Consolas, Courier New"
                     FontSize="13"
                     Padding="10,8"
                     BorderThickness="0"
                     UndoLimit="200"
                     SpellCheck.IsEnabled="False"
                     Background="{DynamicResource Brush.Document.Background}"
                     Foreground="{DynamicResource Brush.Foreground}"
                     CaretBrush="{DynamicResource Brush.Foreground}"
                     TextChanged="OnEditorTextChanged" />

            <GridSplitter x:Name="EditorSplitter"
                          Grid.Column="1"
                          Width="6"
                          Visibility="Collapsed"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext"
                          Focusable="False"
                          AutomationProperties.AutomationId="EditorSplitter"
                          AutomationProperties.Name="Resize the editor"
                          Background="{DynamicResource Brush.Border}"
                          DragCompleted="OnSplitterDragCompleted" />

            <!-- Holds the tab's WebView2 (AutomationId "WebView"), created in code. -->
            <Grid x:Name="WebViewHost" Grid.Column="2" />
        </Grid>

        <Border x:Name="HostErrorPanel"
                Grid.Row="1"
                Visibility="Collapsed"
                AutomationProperties.AutomationId="DocumentHostError"
                Background="{DynamicResource Brush.Document.Background}">
            <StackPanel MaxWidth="640" Margin="32" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="HostErrorTitle"
                           FontSize="20"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource Brush.Foreground}" />
                <TextBlock x:Name="HostErrorMessage"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource Brush.Foreground}" />
                <TextBox x:Name="HostErrorPath"
                         Margin="0,12,0,0"
                         Padding="0"
                         IsReadOnly="True"
                         BorderThickness="0"
                         Background="Transparent"
                         TextWrapping="Wrap"
                         Foreground="{DynamicResource Brush.Foreground.Muted}" />
                <Button x:Name="HostErrorRetryButton"
                        AutomationProperties.AutomationId="HostErrorRetryButton"
                        Margin="0,16,0,0"
                        Padding="14,5"
                        HorizontalAlignment="Left"
                        Content="Try again"
                        Click="OnHostErrorRetryClick" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
