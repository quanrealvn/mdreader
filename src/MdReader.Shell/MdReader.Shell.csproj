<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MdReader.Shell</RootNamespace>
  </PropertyGroup>

  <!-- Deliberately no UI-framework reference: this assembly is what the WPF shell and the Avalonia shell share.
       Anything that owns a window, a handle, a dialog, the clipboard, placement or theming glue belongs in a shell. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MdReader.Core\MdReader.Core.csproj" />
  </ItemGroup>

</Project>
